PORT=4174
NODE_ENV=development

# Comma-separated origins allowed during local development.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# SMTP email provider settings. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Where portfolio contact messages should arrive.
CONTACT_TO_EMAIL=preetiranjansarangi25@gmail.com

# Use smtp for real emails. Use local to save messages in messages/contact-messages.jsonl.
CONTACT_DELIVERY=smtp
